<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 1. Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Tag"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#212529"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <!-- 2. Connect / Disconnect Button & State -->
        <Button
            android:id="@+id/btnConnectToggle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Connect"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#0D6EFD"
            android:textColor="@android:color/white"
            app:cornerRadius="8dp" />

        <TextView
            android:id="@+id/tvConnectionState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disconnected"
            android:textSize="16sp"
            android:textColor="#6C757D"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />

        <!-- 3. Distance Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvApproxDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#6C757D" />

                <TextView
                    android:id="@+id/tvSmoothedRssi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Signal: -- dBm"
                    android:textSize="14sp"
                    android:textColor="#6C757D"
                    android:paddingTop="2dp"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/tvDistanceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#6C757D"
                    android:paddingBottom="12dp" />

                <Button
                    android:id="@+id/btnCalibrate"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Calibrate (hold tag 1 m away)"
                    android:textSize="12sp"
                    android:enabled="false"
                    android:backgroundTint="#6C757D"
                    android:textColor="@android:color/white"
                    app:cornerRadius="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Distance is approximate (walls and body change the signal)."
                    android:textSize="12sp"
                    android:textColor="#adb5bd"
                    android:gravity="center"
                    android:paddingTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 4. Status Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Protection Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Protection:"
                        android:textSize="16sp"
                        android:textColor="#212529" />
                    <TextView
                        android:id="@+id/tvProtectionValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#6C757D" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E9ECEF" />

                <!-- Alarm Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Alarm:"
                        android:textSize="16sp"
                        android:textColor="#212529" />
                    <TextView
                        android:id="@+id/tvAlarmValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#6C757D" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E9ECEF" />

                <!-- Sensor Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sensor:"
                        android:textSize="16sp"
                        android:textColor="#212529" />
                    <TextView
                        android:id="@+id/tvSensorValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#6C757D" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 5. Arm Switch Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Arm System"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212529" />

                <Switch
                    android:id="@+id/switchArm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:textSize="16sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 6. Two Big Alarm Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="24dp">

            <Button
                android:id="@+id/btnSoundAlarm"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Sound Alarm"
                android:textSize="16sp"
                android:textStyle="bold"
                android:enabled="false"
                android:backgroundTint="#DC3545"
                android:textColor="@android:color/white"
                app:cornerRadius="8dp" />

            <Button
                android:id="@+id/btnStopAlarm"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Stop Alarm"
                android:textSize="16sp"
                android:textStyle="bold"
                android:enabled="false"
                android:backgroundTint="#198754"
                android:textColor="@android:color/white"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- 7. Small Message Line at Bottom -->
        <TextView
            android:id="@+id/tvMessageLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready to connect"
            android:textSize="14sp"
            android:textColor="#6C757D"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
